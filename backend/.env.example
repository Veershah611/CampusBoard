# Copy this file to .env and change the values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusboard_db
JWT_SECRET=change-me-to-a-long-random-string

# Root faculty account created automatically on first start (if none exists)
ROOT_ADMIN_EMAIL=admin@faculty.campusboard.edu
ROOT_ADMIN_PASSWORD=change-me
